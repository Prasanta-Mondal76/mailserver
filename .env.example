# --- Mail service (Vercel par ye 3 env vars dalenge) ---
# Wahi Gmail jiska App Password tumne PlayTube ke liye banaya tha
MAIL_USER=yourgmail@gmail.com
# Gmail App Password (16 characters, spaces ke bina)
MAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Secret key jo sirf tumhare backends ko pata hogi.
# Ek lamba random text khud banao (jaise 32+ characters) aur SAME key
# is service me aur har calling project (PlayTube etc.) me rakho.
MAIL_SERVICE_API_KEY=change-this-to-a-long-random-secret
# Optional: mail me dikhne wala sender naam (project apna fromName bhi bhej sakta hai)
FROM_NAME=PlayTube
